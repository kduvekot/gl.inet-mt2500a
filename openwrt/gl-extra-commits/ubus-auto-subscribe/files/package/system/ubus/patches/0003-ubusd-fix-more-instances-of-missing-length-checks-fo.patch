From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felix Fietkau <nbd@nbd.name>
Date: Fri, 17 Oct 2025 10:25:55 +0000
Subject: [PATCH 3/4] ubusd: fix more instances of missing length checks for
 patterns

More instances of the same bug fixed by commit d31effb4277bd5.

Reported-by: Karsten Sperling <ksperling@apple.com>
Signed-off-by: Felix Fietkau <nbd@nbd.name>
---
 ubusd_acl.c   | 17 +++++++++++++++++
 ubusd_proto.c |  3 +++
 2 files changed, 20 insertions(+)

diff --git a/ubusd_acl.c b/ubusd_acl.c
index e050e2c..cf2a272 100644
--- a/ubusd_acl.c
+++ b/ubusd_acl.c
@@ -240,6 +240,9 @@ ubusd_acl_alloc_obj(struct ubusd_acl_file *file, const char *obj)
 	char *k;
 	bool partial = false;
 
+	if (!len)
+		return NULL;
+
 	if (obj[len - 1] == '*') {
 		partial = true;
 		len--;
@@ -270,6 +273,8 @@ ubusd_acl_add_access(struct ubusd_acl_file *file, struct blob_attr *obj)
 		return;
 
 	o = ubusd_acl_alloc_obj(file, blobmsg_name(obj));
+	if (!o)
+		return;
 
 	o->methods = tb[ACL_ACCESS_METHODS];
 	o->tags = tb[ACL_ACCESS_TAGS];
@@ -284,6 +289,9 @@ ubusd_acl_add_subscribe(struct ubusd_acl_file *file, const char *obj)
 {
 	struct ubusd_acl_obj *o = ubusd_acl_alloc_obj(file, obj);
 
+	if (!o)
+		return;
+
 	o->subscribe = true;
 }
 
@@ -292,6 +300,9 @@ ubusd_acl_add_publish(struct ubusd_acl_file *file, const char *obj)
 {
 	struct ubusd_acl_obj *o = ubusd_acl_alloc_obj(file, obj);
 
+	if (!o)
+		return;
+
 	o->publish = true;
 }
 
@@ -299,6 +310,9 @@ static void ubusd_acl_add_listen(struct ubusd_acl_file *file, const char *obj)
 {
 	struct ubusd_acl_obj *o = ubusd_acl_alloc_obj(file, obj);
 
+	if (!o)
+		return;
+
 	o->listen = true;
 }
 
@@ -306,6 +320,9 @@ static void ubusd_acl_add_send(struct ubusd_acl_file *file, const char *obj)
 {
 	struct ubusd_acl_obj *o = ubusd_acl_alloc_obj(file, obj);
 
+	if (!o)
+		return;
+
 	o->send = true;
 }
 
diff --git a/ubusd_proto.c b/ubusd_proto.c
index b20f91c..050baff 100644
--- a/ubusd_proto.c
+++ b/ubusd_proto.c
@@ -201,6 +201,9 @@ static int ubusd_handle_lookup(struct ubus_client *cl, struct ubus_msg_buf *ub,
 
 	objpath = blob_data(attr[UBUS_ATTR_OBJPATH]);
 	len = strlen(objpath);
+	if (!len)
+		return UBUS_STATUS_INVALID_ARGUMENT;
+
 	if (objpath[len - 1] != '*') {
 		obj = avl_find_element(&path, objpath, obj, path);
 		if (!obj)
