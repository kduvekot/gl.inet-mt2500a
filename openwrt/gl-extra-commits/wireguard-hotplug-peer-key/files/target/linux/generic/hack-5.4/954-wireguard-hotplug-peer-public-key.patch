+static const char b64_table[] =
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+static void keytobase64(const unsigned char *src, int len, char *out)
+{
+    size_t i = 0, j = 0, mod = 0;
+
+    while (i < len) {
+        uint32_t octet_a = i < len ? (uint32_t)src[i++] : 0;
+        uint32_t octet_b = i < len ? (uint32_t)src[i++] : 0;
+        uint32_t octet_c = i < len ? (uint32_t)src[i++] : 0;
+
+        uint32_t triple = (octet_a << 16) | (octet_b << 8) | octet_c;
+
+        out[j++] = b64_table[(triple >> 18) & 0x3F];
+        out[j++] = b64_table[(triple >> 12) & 0x3F];
+        out[j++] = (i - 1 > len) ? '=' : b64_table[(triple >> 6) & 0x3F];
+        out[j++] = (i > len) ? '=' : b64_table[triple & 0x3F];
+    }
+
+    mod = len % 3;
+    if (mod == 1) {
+        out[j - 1] = '=';
+        out[j - 2] = '=';
+    } else if (mod == 2) {
+        out[j - 1] = '=';
+    }
+
+    out[j] = '\0';
+}
